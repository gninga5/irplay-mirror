<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView focalizzabile: le frecce su/giù del telecomando scorrono il testo. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingHorizontal="56dp"
    android:paddingVertical="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/iRPlay.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/licenses_title" />

        <TextView
            style="@style/iRPlay.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/licenses_hint" />

        <TextView
            android:id="@+id/license_text"
            style="@style/iRPlay.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:padding="24dp"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
