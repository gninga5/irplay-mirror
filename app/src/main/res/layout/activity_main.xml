<?xml version="1.0" encoding="utf-8"?>
<!-- Schermo del ricevitore. In attesa: home con stato, istruzioni e impostazioni.
     Durante il mirroring la home sparisce e resta la SurfaceView, ridimensionata da
     MainActivity.fitVideo() secondo l'aspect ratio (bande nere ai lati o sopra e sotto).
     Layout pensato per 960x540 dp (TV 1080p a densità xhdpi) e navigazione col D-pad. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.MainActivity">

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/idle_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home"
        android:orientation="vertical"
        android:paddingHorizontal="56dp"
        android:paddingVertical="36dp">

        <!-- Intestazione: logo, nome, stato -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/logo_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/iRPlay.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/iRPlay.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/status_short"
                    style="@style/iRPlay.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contenuto: dati del ricevitore e istruzioni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Nome della TV: selezionabile col D-pad, OK apre la finestra per cambiarlo.
                     Margini laterali negativi: il bordo di focus sporge senza spostare il testo
                     (la scheda ha clipToPadding=false, altrimenti verrebbe tagliato). -->
                <LinearLayout
                    android:id="@+id/name_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-12dp"
                    android:background="@drawable/bg_focusable_subtle"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        style="@style/iRPlay.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_tv_name" />

                    <TextView
                        android:id="@+id/receiver_name"
                        style="@style/iRPlay.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        style="@style/iRPlay.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/rename_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/iRPlay.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_ip" />

                <TextView
                    android:id="@+id/ip_address"
                    style="@style/iRPlay.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    style="@style/iRPlay.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_status" />

                <TextView
                    android:id="@+id/status"
                    style="@style/iRPlay.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_weight="1.35"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/iRPlay.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/how_to_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/iRPlay.StepNumber"
                        android:text="1" />

                    <TextView
                        style="@style/iRPlay.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/step_1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/iRPlay.StepNumber"
                        android:text="2" />

                    <TextView
                        style="@style/iRPlay.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/step_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/iRPlay.StepNumber"
                        android:text="3" />

                    <TextView
                        android:id="@+id/step_3"
                        style="@style/iRPlay.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/iRPlay.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_note"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Impostazioni e licenze: unici elementi focalizzabili -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/auto_open_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <requestFocus />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/iRPlay.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_open_title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/auto_open_summary"
                        style="@style/iRPlay.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Non focalizzabile: si attiva premendo OK sull'intera riga. -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/auto_open_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pin_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <TextView
                    style="@style/iRPlay.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pin_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/pin_summary"
                    style="@style/iRPlay.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyrics_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <TextView
                    style="@style/iRPlay.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lyrics_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lyrics_summary"
                    style="@style/iRPlay.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/licenses_button"
                style="@style/iRPlay.Heading"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="28dp"
                android:text="@string/licenses_button"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- In riproduzione: la TV fa da altoparlante (musica, podcast). Nessun elemento
         focalizzabile: BACK interrompe, come durante la duplicazione. -->
    <LinearLayout
        android:id="@+id/now_playing_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="72dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:background="@drawable/bg_card">

            <ImageView
                android:id="@+id/np_placeholder"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note" />

            <ImageView
                android:id="@+id/np_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/np_artwork_description"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_label"
                style="@style/iRPlay.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/np_label" />

            <TextView
                android:id="@+id/np_title"
                style="@style/iRPlay.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/np_artist"
                style="@style/iRPlay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/np_album"
                style="@style/iRPlay.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp" />

            <!-- Testo del brano (facoltativo): 5 righe, quella in corso al centro. -->
            <LinearLayout
                android:id="@+id/np_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/np_l0"
                    style="@style/iRPlay.LyricLine" />

                <TextView
                    android:id="@+id/np_l1"
                    style="@style/iRPlay.LyricLine" />

                <TextView
                    android:id="@+id/np_l2"
                    style="@style/iRPlay.LyricLine.Current"
                    android:layout_marginVertical="4dp" />

                <TextView
                    android:id="@+id/np_l3"
                    style="@style/iRPlay.LyricLine" />

                <TextView
                    android:id="@+id/np_l4"
                    style="@style/iRPlay.LyricLine" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/np_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="28dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_track" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/np_position"
                    style="@style/iRPlay.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/np_duration"
                    style="@style/iRPlay.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/np_source"
                style="@style/iRPlay.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- PIN per associare un dispositivo: sopra a tutto, finché iOS non lo usa o scade.
         Non è focalizzabile: è solo da leggere, il telecomando continua a funzionare sotto. -->
    <FrameLayout
        android:id="@+id/pin_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC05080F"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_solid"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="56dp"
            android:paddingVertical="36dp">

            <TextView
                style="@style/iRPlay.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pin_overlay_title" />

            <TextView
                android:id="@+id/pin_digits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.35"
                android:textColor="@color/accent"
                android:textSize="72sp" />

            <TextView
                style="@style/iRPlay.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pin_overlay_hint" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
