<?xml version="1.0" encoding="utf-8"?>
<!-- Elementi selezionabili col D-pad: con il focus si illuminano con bordo azzurro e
     sfondo più chiaro, così da tre metri si vede sempre dove si trova la selezione. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#2E38BDF8" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#3D38BDF8" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
