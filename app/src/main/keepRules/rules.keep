# Regole R8 di iRPlay.
# NativeBridge è chiamato dal C++ per nome (JNI_OnLoad risolve classe e metodi con
# FindClass/GetStaticMethodID): se R8 rinominasse o rimuovesse questi membri, la build
# release andrebbe in crash all'avvio con un errore che nella build debug non si vede.
-keep class com.irplay.tv.core.NativeBridge {
    *;
}
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}
